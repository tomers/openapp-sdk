# packages/sdk/core — Rust openapp-sdk workspace tasks.
#
# Default recipes run inside Docker (`sdk-core`) so contributors need no host Rust
# toolchain. Use *-host variants for fast local iteration when Rust is installed.
#
# `mod rl` loads `justfiles/rust_lint.just` for `lint-host` / `lint-fix-host` only.

import "../../../justfiles/common.just"

mod rl "../../../justfiles/rust_lint.just"

_workspace := source_directory()
_compose := source_directory() / ".." / "docker" / "compose.yaml"

# `just test` → nextest + JUnit copy for merged Allure (`scripts/sdk_merge_allure_results.py`).
_core_test_with_reports := "mkdir -p .tmp/sdk-reports && " \
    + "cargo nextest run --workspace -P sdk-allure && " \
    + "cp target/nextest/sdk-allure/junit-sdk-core.xml .tmp/sdk-reports/"

_:
    @just --list

# --- Docker (default): same image/service as `just sdk docker core` ---

_core_cmd CMD:
    bash {{ _sdk_compose_sh }} -f {{ _compose }} run --rm sdk-core \
        sh -euxc '{{ CMD }}'

# `cargo build --workspace`
build:
    @just _core_cmd 'cargo build --workspace'

# Single source of truth for the C bridge cdylib (release) used by the Go cgo linker and the
# Node FFI loader. Writes packages/sdk/core/target/release/deps/libopenapp_sdk_core_c_bridge.so;
# compose prefers this repo path over the image-baked /usr/local/lib copy, which goes stale
# whenever c-bridge exports change (CI ships a fresh bridge; local `docker compose run` does not).
# The sdk-{go,node} pre-commit hooks delegate here (`just sdk core bridge`) — do not duplicate.
bridge:
    @just _core_cmd 'cargo build -p openapp-sdk-core-c-bridge --release'

# CI-guarded wrapper around `bridge`: a no-op when `$CI` is set (e.g. GitHub Actions), since CI
# already ships a fresh bridge (image rebuild for Go; uploaded host artifact for Node). The
# sdk-{go,node} `_bridge` delegations point here so local `pre-commit`/`test`/`release-gate`
# refresh the cdylib without adding a redundant sdk-core build to the CI release-gate path.
# Single source of the CI guard — do not duplicate in the per-SDK justfiles.
_bridge-local:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -n "${CI:-}" ]; then
      echo "CI detected; skipping local core bridge build (CI ships a fresh bridge)." >&2
      exit 0
    fi
    just -f "{{ justfile() }}" bridge

# `cargo nextest` (JUnit for merged Allure) + workspace scope; see `.config/nextest.toml`.
test:
    @just _core_cmd '{{ _core_test_with_reports }}'

# fmt --check, then clippy (workspace, all targets, all features).
lint:
    @just _core_cmd 'cargo fmt --all -- --check && cargo clippy --workspace --all-targets --all-features -- -D warnings'

# clippy --fix, then `cargo fmt` (matches `lint-fix-workspace-all-features` intent).
lint-fix *ARGS:
    @just _core_cmd 'cargo clippy --workspace --all-targets --all-features --fix {{ ARGS }} -- -D warnings && cargo fmt --all'

fmt:
    @just _core_cmd 'cargo fmt --all'

# Canonical SDK recipe name (`MULTI_SDK_ROADMAP.md`); same as `openapi-gen`.
generate: openapi-gen

# Regenerate `crates/common/src/generated.rs` from packages/api-spec/openapi.json.
openapi-gen:
    @just _core_cmd 'cd crates/common && cargo run --features openapi-gen --bin openapp-sdk-openapi-gen'

# Fail the build if the committed generated file is stale vs packages/api-spec/openapi.json.
openapi-check:
    @just _core_cmd 'cd crates/common && cargo run --features openapi-gen --bin openapp-sdk-openapi-gen -- --check'

# Regenerate generated.rs during pre-commit, then fail if the user needs to stage it.
_openapi-gen-pre-commit: openapi-gen
    #!/usr/bin/env bash
    set -euo pipefail

    repo_root="$(git rev-parse --show-toplevel)"
    generated="packages/sdk/core/crates/common/src/generated.rs"
    if ! git -C "$repo_root" diff --quiet -- "$generated"; then
        echo "$generated was regenerated from packages/api-spec/openapi.json." >&2
        echo "Run: git add $generated" >&2
        exit 1
    fi

# If lint fails: `lint-fix` then exit 1 (unstaged fixes; same idea as backend pre-commit). Otherwise openapi check + test.
pre-commit:
    #!/usr/bin/env bash
    set -euo pipefail

    if just lint; then
      just _openapi-gen-pre-commit
      just build
      just test
      exit 0
    fi
    just lint-fix --allow-dirty
    exit 1

# Publish workspace crates to crates.io (dependency order). Uses host `cargo`
# (registry credentials). Forward flags e.g. `just publish -- --dry-run`.
# Skips a crate if this version is already on the registry (so a partial
# release can still publish the remaining packages).
publish *ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ _workspace }}"
    cargo_publish_skip_if_present() {
      local pkg="$1"
      local log
      log="$(mktemp)"
      set +e
      cargo publish -p "$pkg" {{ ARGS }} 2>&1 | tee "$log"
      local st="${PIPESTATUS[0]}"
      set -e
      if [[ "$st" -eq 0 ]]; then
        rm -f "$log"
        return 0
      fi
      if grep -qiE 'already exists|already uploaded|duplicate version|version.*already' "$log"; then
        echo "Skipping ${pkg}: same version already on crates.io." >&2
        rm -f "$log"
        return 0
      fi
      cat "$log" >&2
      rm -f "$log"
      return "$st"
    }
    for pkg in openapp-sdk-common openapp-sdk-core openapp-sdk-core-c-bridge; do
      cargo_publish_skip_if_present "$pkg"
    done

# --- Host Rust (optional): when `cargo` is installed ---

build-host:
    cd {{ _workspace }} && cargo build --workspace

test-host:
    cd {{ _workspace }} && cargo test --workspace

lint-host: rl::format rl::clippy-workspace-all-features

lint-fix-host *args: (rl::lint-fix-workspace-all-features args)

openapi-gen-host:
    cd {{ _workspace }}/crates/common && cargo run --features openapi-gen --bin openapp-sdk-openapi-gen

openapi-check-host:
    cd {{ _workspace }}/crates/common && cargo run --features openapi-gen --bin openapp-sdk-openapi-gen -- --check
