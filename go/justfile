# packages/sdk/go — OpenAPI Generator Go client (docker-based codegen).

import "../../../justfiles/common.just"

_pkg := source_directory()
_repo := source_directory() / ".." / ".." / ".."
# Same service as `just sdk docker go` (packages/sdk/docker/compose.yaml) — no host Go required.
_compose := source_directory() / ".." / "docker" / "compose.yaml"
_openapi_generator_image := "openapitools/openapi-generator-cli:v7.12.0"
# Same Go toolchain as packages/sdk/docker/go/Dockerfile (pin patch + trixie).
_go_toolchain_image := "golang:1.26.2-trixie"

# `go test -json` for merged Allure (`scripts/sdk_merge_allure_results.py`).
_go_test_with_reports := "mkdir -p .tmp/sdk-reports && " \
    + "go test ./... -json > .tmp/sdk-reports/go-test.jsonl"

_:
    @just --list

# Regenerate all Go sources from the repo OpenAPI spec (same image as CI).
generate:
    docker run --rm \
        -u "$(id -u):$(id -g)" \
        -v "{{ _repo }}:/workspace" \
        {{ _openapi_generator_image }} generate \
        -i /workspace/packages/api-spec/openapi.json \
        -g go \
        -o /workspace/packages/sdk/go \
        --git-user-id tomers \
        --git-repo-id openapp-sdk/go \
        --additional-properties=generateMarshalJSON=false,enumClassPrefix=true
    bash "{{ _pkg }}/scripts/fix_openapi_generator_go.sh"
    docker run --rm \
        -u "$(id -u):$(id -g)" \
        -v "{{ _repo }}:/workspace" \
        -w /workspace/packages/sdk/go \
        -e GOCACHE=/tmp/gocache \
        -e GOMODCACHE=/tmp/gomodcache \
        {{ _go_toolchain_image }} \
        bash -eux scripts/post_openapi_generate_go.sh

openapi-check: generate
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ _pkg }}"
    git diff --exit-code -- .

# Bind-mounted GOCACHE/GOMODCACHE must exist as the invoking user before sdk-go runs.
_ensure_host_go_caches:
    bash "{{ _pkg }}/scripts/ensure_host_go_caches.sh" "{{ _pkg }}"

# Run Go via sdk-go container (see packages/sdk/docker/go/Dockerfile).
_go *ARGS: _ensure_host_go_caches
    bash {{ _sdk_compose_sh }} -f {{ _compose }} run --rm sdk-go \
        sh -euxc 'go {{ ARGS }}'

# Multi-step Go commands in one container (`&&` chains).
_go_cmd CMD: _ensure_host_go_caches
    bash {{ _sdk_compose_sh }} -f {{ _compose }} run --rm sdk-go \
        sh -euxc '{{ CMD }}'

lint:
    @just _go vet ./...

build:
    @just _go build ./...

# `_bridge` first so ad-hoc local runs link against a current cdylib (same reason as `pre-commit`).
test: _bridge
    @just _go_cmd '{{ _go_test_with_reports }}'

gherkin-tier0:
    @just _go_cmd 'OPENAPP_SDK_GHERKIN_TAGS="@tier0 and not @wip" go test . -run TestGherkinTier1 -count=1'

# Vet/build/test in sdk-go only. Build the image first: `scripts/sdk-compose.sh -f packages/sdk/docker/compose.yaml build sdk-go`
# (see `.github/workflows/sdk-unified-release.yml`). `_bridge` first so the cgo linker uses a current
# cdylib locally; it's a no-op under `$CI`, where the image rebuild already ships a fresh bridge.
release-gate: _bridge
    @just _go_cmd 'go vet ./... && go build ./... && go test ./...'

# Refresh the core C bridge cdylib before cgo links against it. Delegates to the single source of
# truth (`just sdk core _bridge-local`) so the compose service / cargo flags / CI guard never drift.
_bridge:
    @just -f "{{ source_directory() }}/../core/justfile" _bridge-local

# Host mkdir helper + sdk-compose --user rewriting (no Docker daemon).
test-cache-dirs:
    bash "{{ _pkg }}/scripts/ensure_host_go_caches_test.sh"
    bash "{{ _repo }}/scripts/sdk-compose_test.sh"

# Invoked from repo root via `scripts/pre-commit-subproject-wrapper.sh packages/sdk/go`.
# Same openapi drift gate as CI (`just sdk go openapi-check`); hook wiring is `.pre-commit-config.yaml`.
# `release-gate` carries the `_bridge` prerequisite, so the cdylib is fresh before vet/build/test.
pre-commit:
    @just test-cache-dirs
    @just openapi-check
    @just release-gate

# Go modules ship via git tags (`sdk-go-v*`); no registry upload. Verifies tests; see VERSIONING.md for tagging.
publish:
    @echo >&2 "Go: push a version tag to release (e.g. sdk-go-v0.1.0); see packages/sdk/docs/VERSIONING.md. Verifying module…"
    @just _go_cmd 'go test ./...'
